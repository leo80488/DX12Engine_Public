{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "vs-x64",
            "displayName": "Visual Studio 2022 (x64)",
            "description": "Multi-config VS generator. Pick Debug/Release in the IDE. All deps vendored under DX12/external/.",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build"
        },
        {
            "name": "ninja-debug",
            "displayName": "Ninja (Debug, x64)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ninja-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "ninja-release",
            "displayName": "Ninja (Release, x64)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/ninja-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        { "name": "vs-x64-debug",   "configurePreset": "vs-x64", "configuration": "Debug" },
        { "name": "vs-x64-release", "configurePreset": "vs-x64", "configuration": "Release" },
        { "name": "ninja-debug",    "configurePreset": "ninja-debug" },
        { "name": "ninja-release",  "configurePreset": "ninja-release" }
    ]
}
